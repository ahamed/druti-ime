{
  "format": 1,
  "description": "ime-composer spec: Autocorrect setting, Correcting the word when it ends, Backspace undoes a correction",
  "cases": [
    {"name": "Default is off", "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " ", "expect": {"commit": "আম্রা ", "pending": "", "handled": true}}], "committed": "আম্রা "},
    {"name": "Correction at space", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a", "expect": {"commit": "", "pending": "আম্রা", "handled": true}}, {"key": " ", "expect": {"commit": "", "pending": "আমরা ", "handled": true}}], "committed": ""},
    {"name": "Next key commits the correction", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"key": "k", "expect": {"commit": "আমরা ", "pending": "ক", "handled": true}}], "committed": "আমরা "},
    {"name": "Uncorrected word commits as usual", "config": {"autocorrect": true}, "steps": [{"key": "b"}, {"key": "h"}, {"key": "o"}, {"key": "k"}, {"key": "t"}, {"key": " ", "expect": {"commit": "ভক্ত ", "pending": "", "handled": true}}], "committed": "ভক্ত "},
    {"name": "Correction before a held dari", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": ".", "expect": {"commit": "", "pending": "আমরা।", "handled": true}}], "committed": ""},
    {"name": "Enter commits at once", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": "Enter", "expect": {"commit": "আমরা", "pending": "", "handled": false}}], "committed": "আমরা"},
    {"name": "Undo", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"backspace": 1, "expect": {"commit": "", "pending": "আম্রা", "handled": true}}], "committed": ""},
    {"name": "Undone word is kept", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"backspace": 1}, {"key": " ", "expect": {"commit": "আম্রা ", "pending": "", "handled": true}}], "committed": "আম্রা "},
    {"name": "Second Backspace edits as usual", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"backspace": 1}, {"backspace": 1, "expect": {"commit": "", "pending": "আম্র", "handled": true}}], "committed": ""},
    {"name": "The kept mark ends with the word", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"backspace": 1}, {"key": " "}, {"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " ", "expect": {"commit": "", "pending": "আমরা ", "handled": true}}], "committed": "আম্রা "},
    {"name": "Typing on after an undo keeps the word", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"backspace": 1}, {"key": "i", "expect": {"commit": "", "pending": "আম্রাই", "handled": true}}, {"key": " ", "expect": {"commit": "আম্রাই ", "pending": "", "handled": true}}], "committed": "আম্রাই "},
    {"name": "A consonant after an undo starts a new letter", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "h"}, {"key": "m"}, {"key": "o"}, {"key": "d"}, {"key": " "}, {"backspace": 1, "expect": {"commit": "", "pending": "আহ্মদ", "handled": true}}, {"key": "h", "expect": {"commit": "", "pending": "আহ্মদহ", "handled": true}}], "committed": ""},
    {"name": "Digit ends the word", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": "1", "expect": {"commit": "", "pending": "আমরা১", "handled": true}}, {"key": " ", "expect": {"commit": "আমরা১ ", "pending": "", "handled": true}}], "committed": "আমরা১ "},
    {"name": "Punctuation ends the word", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "p"}, {"key": "n"}, {"key": "i"}, {"key": "?", "expect": {"commit": "", "pending": "আপনি?", "handled": true}}, {"key": " ", "expect": {"commit": "আপনি? ", "pending": "", "handled": true}}], "committed": "আপনি? "},
    {"name": "Dash after a correction", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": "-"}, {"key": "-", "expect": {"commit": "আমরা—", "pending": "", "handled": true}}], "committed": "আমরা—"},
    {"name": "Dari then full stop", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": "."}, {"key": ".", "expect": {"commit": "আমরা..", "pending": "", "handled": true}}], "committed": "আমরা.."},
    {"name": "Vowel after a correction", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"key": "a", "expect": {"commit": "আমরা ", "pending": "আ", "handled": true}}], "committed": "আমরা "},
    {"name": "Flush commits the correction", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"flush": 1, "expect": {"commit": "আমরা ", "pending": "", "handled": true}}], "committed": "আমরা "},
    {"name": "Enter after a correction", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"key": "Enter", "expect": {"commit": "আমরা ", "pending": "", "handled": false}}], "committed": "আমরা "},
    {"name": "Unhandled key after a correction", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"key": "ArrowLeft", "expect": {"commit": "আমরা ", "pending": "", "handled": false}}], "committed": "আমরা "},
    {"name": "Unhandled key without a correction", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": "ArrowLeft", "expect": {"commit": "", "pending": "আম্রা", "handled": false}}], "committed": ""},
    {"name": "Reset drops the correction", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"reset": 1}, {"backspace": 1, "expect": {"commit": "", "pending": "", "handled": false}}], "committed": ""},
    {"name": "Sentence", "config": {"autocorrect": true}, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"key": "e"}, {"key": "k"}, {"key": "T"}, {"key": "a"}, {"key": " "}, {"key": "j"}, {"key": "i"}, {"key": "n"}, {"key": "i"}, {"key": "s"}, {"key": " "}, {"key": "d"}, {"key": "e"}, {"key": "k"}, {"key": "h"}, {"key": "t"}, {"key": "e"}, {"key": " "}, {"key": "c"}, {"key": "a"}, {"key": "i"}, {"key": " "}], "committed": "আমরা একটা জিনিস দেখতে চাই "},
    {"name": "Sentence with the host's text", "config": {"autocorrect": true}, "hostContext": true, "steps": [{"key": "a"}, {"key": "p"}, {"key": "n"}, {"key": "i"}, {"key": " "}, {"key": "k"}, {"key": "i"}, {"key": " "}, {"key": "b"}, {"key": "o"}, {"key": "l"}, {"key": "t"}, {"key": "e"}, {"key": " "}, {"key": "c"}, {"key": "a"}, {"key": "c"}, {"key": "c"}, {"key": "h"}, {"key": "e"}, {"key": "n"}, {"key": "?"}], "committed": "আপনি কি বলতে চাচ্ছেন?"},
    {"name": "Correction after a document", "config": {"autocorrect": true}, "document": "আমি ", "hostContext": true, "steps": [{"key": "a"}, {"key": "m"}, {"key": "r"}, {"key": "a"}, {"key": " "}, {"key": "i", "expect": {"commit": "আমরা ", "pending": "ই", "handled": true}}], "committed": "আমি আমরা "}
  ]
}
